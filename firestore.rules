rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection
    // users/{uid}
    match /users/{userId} {
      // Authenticated users can view profiles (needed for driver/passenger matching)
      allow read: if isAuthenticated();
      // Only the user can create or update their own profile
      allow create, update: if isOwner(userId);
      // Disallow user deletion directly from client
      allow delete: if false;
    }

    // 2. Vehicles Collection
    // vehicles/{vehicleId}
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // 3. Rides Collection
    // rides/{rideId}
    match /rides/{rideId} {
      // Any authenticated user can search for available rides
      allow read: if isAuthenticated();
      // Only drivers can create rides where driverId matches their uid
      allow create: if isAuthenticated() && request.resource.data.driverId == request.auth.uid;
      // Only the driver can update or cancel their ride
      allow update, delete: if isAuthenticated() && resource.data.driverId == request.auth.uid;
    }

    // 4. Ride Requests Collection
    // rideRequests/{requestId}
    match /rideRequests/{requestId} {
      // Only the passenger or the driver involved in this request can read it
      allow read: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      // A passenger can create a request with their own passengerId
      allow create: if isAuthenticated() && request.resource.data.passengerId == request.auth.uid;
      // Passenger can cancel/update; Driver can accept/decline
      allow update: if isAuthenticated() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.passengerId == request.auth.uid;
    }

    // 5. Real-Time Chats Collection
    // chats/{chatId}
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      allow create: if isAuthenticated() && (
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );

      // Subcollection: messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow update, delete: if false;
      }
    }

    // 6. Notifications Collection
    // notifications/{notificationId}
    match /notifications/{notificationId} {
      // Only recipient can read or update their own notifications
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      // Creation allowed by authenticated users triggering ride actions or system
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // 7. Ratings Collection
    // ratings/{ratingId}
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if false;
    }

    // Fallback: Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
