rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile photos: users/{userId}/profile.jpg
    match /users/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId)
        && request.resource.size < 5 * 1024 * 1024 // 5MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Vehicle photos: vehicles/{vehicleId}/{fileName}
    match /vehicles/{vehicleId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Driver verification documents: verification/{userId}/{fileName}
    match /verification/{userId}/{fileName} {
      // Private: only document owner can read/write
      allow read, write: if isOwner(userId)
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
